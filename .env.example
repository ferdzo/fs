LOG_LEVEL=debug
LOG_FORMAT=text
DATA_PATH=data/
# Blob chunk size in bytes (max 67108864)
CHUNK_SIZE=1048576
FS_MAX_OBJECT_UPLOAD_BYTES=5368709120
PORT=2600
AUDIT_LOG=true
ADDRESS=0.0.0.0
METRICS_ADDRESS=127.0.0.1
# Dedicated Prometheus metrics port (0 disables)
METRICS_PORT=9091
GC_INTERVAL=10
GC_ENABLED=true
MULTIPART_RETENTION_HOURS=24
FS_AUTH_ENABLED=false
FS_AUTH_REGION=us-east-1
FS_AUTH_CLOCK_SKEW_SECONDS=300
FS_AUTH_MAX_PRESIGN_SECONDS=86400
# When FS_AUTH_ENABLED=true you MUST set FS_MASTER_KEY to a strong random value, e.g.:
#   openssl rand -base64 32
FS_MASTER_KEY=REPLACE_WITH_SECURE_RANDOM_KEY
FS_ROOT_USER=
FS_ROOT_PASSWORD=
FS_ROOT_POLICY_JSON=
ADMIN_API_ENABLED=true
# Idle deadline between body reads of an upload; stalls are reaped (0 disables)
FS_BODY_READ_TIMEOUT_SECONDS=60
# Failed-auth throttle per source IP per minute (0 disables)
FS_AUTH_FAILURE_LIMIT_PER_MIN=600
# Chunk storage backend: "disk" (default single path under DATA_PATH) or "erasure" (multi-path Reed-Solomon)
FS_STORAGE_BACKEND=disk
# Comma-separated storage roots when FS_STORAGE_BACKEND=erasure (must equal K + M paths)
# FS_ERASURE_PATHS=/mnt/d1,/mnt/d2,/mnt/d3,/mnt/d4,/mnt/d5,/mnt/d6
# FS_ERASURE_DATA_SHARDS=4
# FS_ERASURE_PARITY_SHARDS=2
# FS_ERASURE_AUTO_HEAL=true
# FS_ERASURE_STRICT_WRITE=false
